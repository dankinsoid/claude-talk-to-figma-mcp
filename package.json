{
  "name": "@dankinsoid/claude-talk-to-figma-mcp",
  "description": "Claude Talk to Figma MCP",
  "version": "0.3.22",
  "publishConfig": {
    "access": "public"
  },
  "module": "dist/server.js",
  "main": "dist/server.js",
